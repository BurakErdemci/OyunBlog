@page
@model MainPage.Pages.IndirimlerModel
@{
    ViewData["Title"] = "Oyun Fırsatları";
}

<div class="container py-5">

    <!-- Sayfa Başlığı -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">Oyun Fırsatları</h1>
        <p class="lead text-muted">Steam ve Epic Games üzerindeki en sıcak indirimleri kaçırma.</p>
    </div>

    <!-- Steam Bölümü -->
    <section id="steam-deals" class="mb-5">
        <div class="d-flex align-items-center mb-4 p-3 rounded-3 shadow-sm bg-white border-start border-5 border-primary">
            <i class="fab fa-steam fa-2x text-primary me-3"></i>
            <div>
                <h2 class="h4 mb-0 fw-bold">Steam İndirimleri</h2>
                <span class="text-muted small">Cüzdan düşmanı indirimler</span>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @if (Model.SteamDeals != null && Model.SteamDeals.Any())
            {
                foreach (var deal in Model.SteamDeals)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm hover-lift">
                            <!-- İndirim Rozeti -->
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-danger shadow-sm py-2 px-3 rounded-pill fw-bold">-%@deal.DiscountPercent</span>
                            </div>

                            <!-- Resim -->
                            <img src="@(string.IsNullOrEmpty(deal.LargeCapsuleImage) ? "https://via.placeholder.com/300x150?text=Resim+Yok" : deal.LargeCapsuleImage)"
                                 class="card-img-top"
                                 alt="@deal.Name"
                                 style="height: 160px; object-fit: cover;">

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-truncate fw-bold" title="@deal.Name">@deal.Name</h5>

                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-decoration-line-through text-muted small">
                                            @(deal.OriginalPrice > 0 ? "$" + (deal.OriginalPrice / 100.0).ToString("0.00") : "-")
                                        </span>
                                        <span class="fs-5 fw-bold text-success">
                                            @(deal.FinalPrice > 0 ? "$" + (deal.FinalPrice / 100.0).ToString("0.00") : "BEDAVA")
                                        </span>
                                    </div>
                                    <a href="https://store.steampowered.com/app/@deal.Id" target="_blank" class="btn btn-outline-primary w-100 fw-bold rounded-pill">
                                        <i class="fab fa-steam me-1"></i> İncele
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning" role="alert">
                        Şu an Steam'de gösterilecek indirimli oyun bulunamadı.
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Epic Games Bölümü -->
    <section id="epic-deals" class="mt-5">
        <div class="d-flex align-items-center mb-4 p-3 rounded-3 shadow-sm bg-dark text-white border-start border-5 border-warning">
            <i class="fas fa-cube fa-2x text-warning me-3"></i>
            <div>
                <h2 class="h4 mb-0 fw-bold">Epic Games Store</h2>
                <span class="text-white-50 small">Haftalık ücretsiz oyunlar ve fırsatlar</span>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @if (Model.EpicDeals != null && Model.EpicDeals.Any())
            {
                foreach (var deal in Model.EpicDeals)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm hover-lift">
                            <!-- İndirim Rozeti (Eğer %100 ise Ücretsiz yazalım) -->
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (deal.DiscountPercent >= 100)
                                {
                                    <span class="badge bg-success shadow-sm py-2 px-3 rounded-pill fw-bold">ÜCRETSİZ</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark shadow-sm py-2 px-3 rounded-pill fw-bold">-%@deal.DiscountPercent</span>
                                }
                            </div>

                            <img src="@(string.IsNullOrEmpty(deal.LargeCapsuleImage) ? "https://via.placeholder.com/300x150?text=Resim+Yok" : deal.LargeCapsuleImage)"
                                 class="card-img-top"
                                 alt="@deal.Name"
                                 style="height: 160px; object-fit: cover;">

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-truncate fw-bold" title="@deal.Name">@deal.Name</h5>

                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-decoration-line-through text-muted small">
                                            @(deal.OriginalPrice > 0 ? "$" + (deal.OriginalPrice / 100.0).ToString("0.00") : "-")
                                        </span>
                                        <span class="fs-5 fw-bold text-dark">
                                            @(deal.FinalPrice > 0 ? "$" + (deal.FinalPrice / 100.0).ToString("0.00") : "BEDAVA")
                                        </span>
                                    </div>
                                    <a href="@GetEpicUrl(deal)" target="_blank" class="btn btn-dark w-100 fw-bold rounded-pill">
                                        <i class="fas fa-external-link-alt me-1"></i> Epic'te Aç
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-secondary" role="alert">
                        Epic Games fırsatları şu an çekilemiyor.
                    </div>
                </div>
            }
        </div>
    </section>

</div>

@functions {
    private string GetEpicUrl(Core.Concretes.DTOs.DealDto deal)
    {
        return deal.GameUrl ?? "https://store.epicgames.com/";
    }
}

<!-- Bu Sayfaya Özel CSS -->
<style>
    /* Kartların üzerine gelince yukarı doğru hareket etmesi için */
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>