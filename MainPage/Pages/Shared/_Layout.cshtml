<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oyun Blog</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">


    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f3f4f6;
            color: #1f2937;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }

        .navbar {
            background-color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .navbar-brand {
            color: #4f46e5 !important;
            font-size: 1.5rem;
        }

        .nav-link {
            color: #4b5563 !important;
            font-weight: 600;
            transition: all 0.3s;
        }

            .nav-link:hover {
                color: #4f46e5 !important;
                transform: translateY(-1px);
            }

        .btn-gradient {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: white;
            border: none;
        }

            .btn-gradient:hover {
                background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
                color: white;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            }

        footer {
            background-color: #ffffff;
            border-top: 1px solid #e5e7eb;
            margin-top: auto;
            padding: 2rem 0;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="fa-solid fa-gamepad me-2 text-primary"></i>
                <span style="background: -webkit-linear-gradient(45deg, #4f46e5, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">OYUN BLOG</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="fa-solid fa-bars text-dark"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link" href="/">Ana Sayfa</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Oyunlar">Oyunlar</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Indirimler">İndirimler <span class="badge bg-danger rounded-pill ms-1" style="font-size:0.7em;">HOT</span></a></li>
                    <li class="nav-item"><a class="nav-link" href="/Forum">Forum</a></li>
                </ul>

                <form class="d-flex me-3" method="get" action="/Forum">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                        <input class="form-control bg-light border-start-0 ps-0" type="search" name="q" placeholder="Ara...">
                    </div>
                </form>

                <ul class="navbar-nav align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width:32px; height:32px; font-size:14px;">
                                    @User.Identity.Name.Substring(0, 1).ToUpper()
                                </div>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="fa-solid fa-user me-2 text-primary"></i>Profil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/Account/Logout">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-sign-out-alt me-2"></i>Çıkış</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-primary btn-sm px-3 rounded-pill" href="/Account/Login">Giriş</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-gradient btn-sm px-3 rounded-pill" href="/Account/Register">Kayıt Ol</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="text-center text-muted">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start">
                    <span class="fw-bold text-dark">Oyun Blog</span> &copy; @DateTime.Now.Year
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <a href="#" class="text-muted me-3"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="text-muted me-3"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="text-muted"><i class="fab fa-github"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
  

        var successMsg = '@TempData["Success"]';
        var errorMsg = '@TempData["Error"]';
        var statusMsg = '@TempData["StatusMessage"]';

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Başarılı!',
                text: successMsg,
                confirmButtonColor: '#4f46e5'
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Hata!',
                text: errorMsg,
                confirmButtonColor: '#e53935'
            });
        }

  
        if (statusMsg) {
            if(statusMsg.includes("Error") || statusMsg.includes("Hata")) {
                 Swal.fire({ icon: 'error', title: 'Dikkat', text: statusMsg });
            } else {
                 Swal.fire({ icon: 'success', title: 'Bilgi', text: statusMsg, confirmButtonColor: '#4f46e5' });
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>