@page "{id:int}"
@model MainPage.Pages.TopicModel
@{
    ViewData["Title"] = Model.Topic?.Title ?? "Konu Detayı";

    // DTO'da UserName direkt var
    var authorName = Model.Topic?.UserName ?? "Bilinmeyen Kullanıcı";
    var authorInitial = !string.IsNullOrEmpty(authorName) ? authorName.Substring(0, 1).ToUpper() : "U";

    // DTO'da CategoryName direkt var
    var categoryName = Model.Topic?.CategoryName ?? "Genel";
}

<div class="container py-5">

    <a href="/Forum" class="text-decoration-none text-muted mb-4 d-inline-block fw-bold small hover-back">
        <i class="fa-solid fa-arrow-left me-1"></i> Foruma Dön
    </a>

    <!-- Ana Konu Kartı -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
        <div class="card-body p-0">
            <div class="p-4 bg-light border-bottom">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-2">
                            @categoryName
                        </span>
                        <h1 class="fw-bold text-dark h2 mb-2">@Model.Topic.Title</h1>
                        <div class="text-muted small">
                            <i class="fa-regular fa-clock me-1"></i> @Model.Topic.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                            <span class="mx-2">•</span>
                            <i class="fa-regular fa-eye me-1"></i> @Model.Topic.ViewCount görüntülenme
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 p-md-5 bg-white">
                <div class="d-flex gap-4">
                    <div class="d-none d-md-flex flex-column align-items-center" style="min-width: 80px;">
                        <div class="bg-gradient-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm mb-2"
                             style="width: 64px; height: 64px; font-size: 24px; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
                            @authorInitial
                        </div>
                        <span class="fw-bold small text-dark text-center">@authorName</span>
                    </div>

                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center d-md-none mb-3 border-bottom pb-2">
                            <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 40px; height: 40px;">
                                @authorInitial
                            </div>
                            <span class="fw-bold text-dark">@authorName</span>
                        </div>

                        <!-- DTO'ya eklediğimiz Content alanı -->
                        <div class="text-dark opacity-75 fs-5" style="white-space: pre-wrap; line-height: 1.7;">
                            @Model.Topic.Content
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Yanıtlar -->
    <div class="mb-4">
        <h3 class="fw-bold text-dark h4 mb-4">
            <i class="fa-regular fa-comments me-2 text-primary"></i>Yanıtlar (@(Model.Topic.Replies?.Count ?? 0))
        </h3>

        @if (Model.Topic.Replies != null && Model.Topic.Replies.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var reply in Model.Topic.Replies)
                {
                    // Yanıt entity'sinden kullanıcı adını çekiyoruz
                    var replyUser = reply.User?.UserName ?? "Misafir";
                    var replyInitial = !string.IsNullOrEmpty(replyUser) ? replyUser.Substring(0, 1).ToUpper() : "U";

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex gap-3">
                                <div class="flex-shrink-0">
                                    <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center"
                                         style="width: 48px; height: 48px; font-size: 18px;">
                                        @replyInitial
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="fw-bold text-dark me-2">@replyUser</span>
                                            <span class="text-muted small">@reply.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                    <p class="mb-0 text-dark opacity-75">@reply.Content</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted bg-white rounded-4 border border-dashed">
                <p class="mb-0">Henüz kimse yanıt yazmamış.</p>
            </div>
        }
    </div>

    <!-- Yanıt Yaz Alanı -->
    @if (User.Identity.IsAuthenticated)
    {
        <div class="card border-0 shadow-lg rounded-4 mt-5">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3 h5">Bir Yanıt Yaz</h4>
                <form method="post" asp-page-handler="Reply">
                    <input type="hidden" name="Id" value="@Model.Topic.Id" />

                    <div class="form-floating mb-3">
                        <!-- Backend'de ismini ReplyContent yaptık -->
                        <textarea asp-for="ReplyContent" class="form-control rounded-3" placeholder="Yorumunuzu buraya yazın..." style="height: 120px"></textarea>
                        <label asp-for="ReplyContent" class="text-muted">Düşüncelerini paylaş...</label>
                        <span asp-validation-for="ReplyContent" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm"
                                style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                            <i class="fa-solid fa-reply me-2"></i>Yanıt Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<style>
    .hover-back:hover {
        color: #4f46e5 !important;
        transform: translateX(-5px);
        transition: transform 0.2s;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>