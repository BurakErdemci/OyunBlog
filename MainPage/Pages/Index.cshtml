@page
@model MainPage.Pages.IndexModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Hero Section (Karşılama Alanı) -->
<section class="position-relative overflow-hidden p-3 p-md-5 m-md-3 text-center bg-white rounded-4 shadow-sm">
    <div class="col-md-8 p-lg-5 mx-auto my-3">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-3">
            <i class="fa-solid fa-rocket me-1"></i> Oyun Dünyası
        </span>
        <h1 class="display-4 fw-bold text-dark mb-3">Oyun Blog'a Hoş Geldiniz</h1>
        <p class="lead fw-normal text-muted mb-4">
            En yeni oyun incelemeleri, teknoloji dünyasından son dakika haberleri ve kaçırılmayacak indirim fırsatları tek bir yerde.
        </p>
        <div class="d-flex gap-3 justify-content-center lead fw-normal">
            <a class="btn btn-primary btn-lg rounded-pill px-4 fw-bold" href="/Oyunlar">
                Oyunları Keşfet <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
            <a class="btn btn-outline-secondary btn-lg rounded-pill px-4" href="/Forum">
                Foruma Katıl
            </a>
        </div>
    </div>
    <div class="product-device shadow-sm d-none d-md-block"></div>
    <div class="product-device product-device-2 shadow-sm d-none d-md-block"></div>
</section>

<!-- Haberler Bölümü -->
<div class="container py-5">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="display-6 fw-bold text-dark mb-0">
            <i class="fa-regular fa-newspaper text-primary me-2"></i>Teknoloji Haberleri
        </h2>
        <a href="#" class="btn btn-link text-decoration-none fw-bold">Tümünü Gör <i class="fa-solid fa-chevron-right small"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.News != null && Model.News.Any())
        {
            foreach (var news in Model.News.Take(6))
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm hover-card">
                        <!-- Görsel -->
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(news.ImageUrl) ? "https://via.placeholder.com/400x250?text=Haber" : news.ImageUrl)"
                                 class="card-img-top"
                                 alt="@news.Title"
                                 style="height: 220px; object-fit: cover;">
                            <div class="card-img-overlay d-flex align-items-end p-0">
                                <div class="bg-gradient-dark w-100 p-3 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                                    <small><i class="fa-regular fa-calendar me-1"></i> @news.PublishedAt.ToString("dd MMM yyyy")</small>
                                </div>
                            </div>
                        </div>

                        <!-- İçerik -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark lh-sm mb-3">
                                <a href="@news.Url" target="_blank" class="text-decoration-none text-dark stretched-link">
                                    @news.Title
                                </a>
                            </h5>
                            <p class="card-text text-muted small flex-grow-1 line-clamp-3">
                                @news.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="badge bg-light text-secondary border">Teknoloji</span>
                                <span class="text-primary small fw-bold">Haberi Oku <i class="fa-solid fa-arrow-right ms-1"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    <div>
                        Şu anda görüntülenecek güncel teknoloji haberi bulunmuyor.
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Bu sayfaya özel stiller -->
<style>
    /* Kart hover efekti */
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }

    /* Metin taşmasını engellemek için (3 satır sınırı) */
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>