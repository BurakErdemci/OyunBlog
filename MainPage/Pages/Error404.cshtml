@page
@{
    ViewData["Title"] = "Sayfa Bulunamadı";
    Layout = "_Layout";
}

<div class="container d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 70vh;">

    <!-- Glitch Efektli Başlık -->
    <h1 class="display-1 fw-bold text-primary" style="font-size: 8rem; text-shadow: 4px 4px 0px #e53935;">404</h1>

    <div class="mb-4">
        <i class="fa-solid fa-gamepad fa-shake fa-4x text-muted mb-3" style="--fa-animation-duration: 3s;"></i>
        <h2 class="fw-bold text-dark">GAME OVER!</h2>
        <p class="lead text-muted">Aradığın level henüz tasarlanmadı veya haritadan silindi.</p>
    </div>

    <div class="d-flex gap-3">
        <a href="/" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm fw-bold"
           style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
            <i class="fa-solid fa-house me-2"></i>Ana Üsse Dön
        </a>
        <a href="/Forum" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
            Foruma Işınlan
        </a>
    </div>

</div>